# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin credentials (from Firebase Console > Project Settings > Service Accounts)
# Option A: point to a downloaded service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: instead of the file above, you can set these three individually
# (useful for hosting providers where uploading a file is inconvenient)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
